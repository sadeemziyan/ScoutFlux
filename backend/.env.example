# Postgres connection strings. For local dev these can be identical.
# In production (Neon), DATABASE_URL is the pooled connection and
# DATABASE_URL_DIRECT is the unpooled one used only by Alembic.
DATABASE_URL=postgresql://user:password@localhost:5432/scoutflux
DATABASE_URL_DIRECT=postgresql://user:password@localhost:5432/scoutflux

# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Gmail account used to send weekly digest emails via SMTP.
# Requires 2-Step Verification, then generate an App Password (not
# your real password) at https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# GitHub Personal Access Token (classic). Zero scopes needed - this is
# only used to read public repo/commit data via GitHub's MCP server.
# Generate at https://github.com/settings/tokens
GITHUB_TOKEN=